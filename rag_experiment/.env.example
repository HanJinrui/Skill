# --- OpenAI-compatible chat model (labeling + skill synthesis) ---
# Historical compatibility note: the code still reads `ZHIPU_API_KEY`.
ZHIPU_API_KEY=
GLM_BASE_URL=https://uni-api.cstcloud.cn/v1
GLM_MODEL=deepseek-v3:671b
GLM_TEMPERATURE=0.1
GLM_MAX_TOKENS=4096
GLM_TIMEOUT=120

# --- Qwen2.5-Coder-7B-Instruct (code generation) ---
QWEN_LOCAL_MODEL_DIR=../.hf-cache/models/Qwen__Qwen2.5-Coder-7B-Instruct
QWEN_MODEL_ID=Qwen/Qwen2.5-Coder-7B-Instruct
QWEN_DEVICE_MAP=auto
QWEN_DTYPE=auto
QWEN_TEMPERATURE=0.8
QWEN_TOP_P=0.95
QWEN_MAX_NEW_TOKENS=2048
QWEN_TRUST_REMOTE_CODE=false

# --- Embeddings for dense retrieval ---
EMBED_MODEL=BAAI/bge-base-en-v1.5
EMBED_DEVICE=cpu

# --- Data / cache paths (relative to rag_experiment/) ---
RAG_OUTPUT_DIR=outputs
RAG_CACHE_DIR=.cache
RAG_TACO_TESTS_PATH=outputs/stage_a/taco_tests.jsonl

# --- HuggingFace cache (reused from parent project) ---
HF_HOME=../.hf-cache
HF_DATASETS_CACHE=../.hf-cache/datasets
