{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/dataset_manifest.schema.json",
  "title": "DatasetManifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "dataset_name",
    "families"
  ],
  "properties": {
    "dataset_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "families": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "family_name",
          "subtypes"
        ],
        "properties": {
          "family_name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "subtypes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "subtype_name",
                "sample_count",
                "samples"
              ],
              "properties": {
                "subtype_name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "sample_count": {
                  "type": "integer",
                  "minimum": 1
                },
                "samples": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "sample_id",
                      "problem_path",
                      "solution_path",
                      "problem_statement",
                      "reference_solution"
                    ],
                    "properties": {
                      "sample_id": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 120
                      },
                      "problem_path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "solution_path": {
                        "type": "string",
                        "minLength": 1
                      },
                      "problem_statement": {
                        "type": "string",
                        "minLength": 10
                      },
                      "reference_solution": {
                        "type": "string",
                        "minLength": 10
                      },
                      "metadata": {
                        "type": "object",
                        "additionalProperties": true
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
