{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/subtype_skill_spec.schema.json",
  "title": "SubtypeSkillSpec",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "skill_name",
    "description",
    "algorithm_family",
    "subtype",
    "generation_decision",
    "trigger_signals",
    "non_triggers",
    "failure_modes",
    "pattern_abstraction",
    "transfer_strategy",
    "output_contract",
    "eval_examples",
    "taxonomy_notes",
    "transfer_checklist",
    "files"
  ],
  "properties": {
    "kind": {
      "const": "subtype_skill"
    },
    "skill_name": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "allOf": [
        {
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        {
          "not": {
            "pattern": "(^|-)skill(-|$)"
          }
        }
      ]
    },
    "description": {
      "type": "string",
      "minLength": 20,
      "maxLength": 300,
      "pattern": "^[a-z0-9][a-z0-9 ,()/_:+.-]*$"
    },
    "algorithm_family": {
      "type": "string",
      "enum": [
        "amortized_analysis",
        "bit_manipulation",
        "complete_search",
        "data_structures",
        "dynamic_programming",
        "greedy_algorithms",
        "range_queries",
        "sorting"
      ]
    },
    "subtype": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80
    },
    "generation_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "should_generate_skill",
        "confidence",
        "reason"
      ],
      "properties": {
        "should_generate_skill": {
          "type": "boolean"
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "reason": {
          "type": "string",
          "minLength": 10,
          "maxLength": 400
        }
      }
    },
    "trigger_signals": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 220
      }
    },
    "non_triggers": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 220
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 4,
        "maxLength": 220
      }
    },
    "pattern_abstraction": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "core_recognition",
        "state_templates",
        "transition_templates",
        "base_case_rules",
        "iteration_order_rules"
      ],
      "properties": {
        "core_recognition": {
          "type": "string",
          "minLength": 20,
          "maxLength": 400
        },
        "state_templates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 220
          }
        },
        "transition_templates": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 220
          }
        },
        "base_case_rules": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 220
          }
        },
        "iteration_order_rules": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 220
          }
        }
      }
    },
    "transfer_strategy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mapping_steps",
        "uncertainty_policy"
      ],
      "properties": {
        "mapping_steps": {
          "type": "array",
          "minItems": 4,
          "maxItems": 10,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 240
          }
        },
        "uncertainty_policy": {
          "type": "array",
          "minItems": 2,
          "maxItems": 6,
          "items": {
            "type": "string",
            "minLength": 5,
            "maxLength": 240
          }
        }
      }
    },
    "output_contract": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sections",
        "default_language",
        "emit_code_only_if_user_asks"
      ],
      "properties": {
        "sections": {
          "const": [
            "思路",
            "状态定义",
            "转移方程",
            "复杂度"
          ]
        },
        "default_language": {
          "const": "python"
        },
        "emit_code_only_if_user_asks": {
          "const": true
        }
      }
    },
    "eval_examples": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "positive",
        "negative"
      ],
      "properties": {
        "positive": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 260
          }
        },
        "negative": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": {
            "type": "string",
            "minLength": 8,
            "maxLength": 260
          }
        }
      }
    },
    "taxonomy_notes": {
      "type": "array",
      "minItems": 3,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 240
      }
    },
    "transfer_checklist": {
      "type": "array",
      "minItems": 4,
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 5,
        "maxLength": 240
      }
    },
    "files": {
      "type": "array",
      "minItems": 0,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "path",
          "content"
        ],
        "properties": {
          "path": {
            "type": "string",
            "enum": [
              "SKILL.md",
              "agents/openai.yaml",
              "references/pattern-taxonomy.md",
              "references/output-format.md",
              "references/transfer-checklist.md"
            ]
          },
          "content": {
            "type": "string",
            "minLength": 20
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "generation_decision": {
            "type": "object",
            "properties": {
              "should_generate_skill": {
                "const": true
              }
            },
            "required": [
              "should_generate_skill"
            ]
          }
        },
        "required": [
          "generation_decision"
        ]
      },
      "then": {
        "properties": {
          "files": {
            "type": "array",
            "minItems": 5,
            "maxItems": 5,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "path",
                "content"
              ],
              "properties": {
                "path": {
                  "type": "string",
                  "enum": [
                    "SKILL.md",
                    "agents/openai.yaml",
                    "references/pattern-taxonomy.md",
                    "references/output-format.md",
                    "references/transfer-checklist.md"
                  ]
                },
                "content": {
                  "type": "string",
                  "minLength": 20
                }
              }
            },
            "allOf": [
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "const": "SKILL.md"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "const": "agents/openai.yaml"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "const": "references/pattern-taxonomy.md"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "const": "references/output-format.md"
                    }
                  }
                }
              },
              {
                "contains": {
                  "type": "object",
                  "required": [
                    "path"
                  ],
                  "properties": {
                    "path": {
                      "const": "references/transfer-checklist.md"
                    }
                  }
                }
              }
            ]
          }
        }
      },
      "else": {
        "properties": {
          "files": {
            "type": "array",
            "maxItems": 0
          }
        }
      }
    }
  ]
}
