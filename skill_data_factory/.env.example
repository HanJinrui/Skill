# Copy to .env. Three keys enable round-robin Pass2 concurrency.
DEEPSEEK_API_KEYS=your_key_1,your_key_2,your_key_3
# Optional single-key fallback when DEEPSEEK_API_KEYS is unset.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_TEMPERATURE=0
DEEPSEEK_MAX_TOKENS=2048
DEEPSEEK_TIMEOUT=180
DEEPSEEK_TRUST_ENV=false
