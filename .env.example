LLM_BACKEND=local_transformers
LLM_PROVIDER_NAME=LocalTransformers
LLM_MODEL=Qwen/Qwen2.5-Coder-7B-Instruct
LLM_LOCAL_MODEL_DIR=.hf-cache/models/Qwen__Qwen2.5-Coder-7B-Instruct
LLM_CACHE_DIR=.hf-cache
LLM_DEVICE_MAP=auto
LLM_DTYPE=auto
LLM_TEMPERATURE=0.2
LLM_MAX_NEW_TOKENS=4096
LLM_TRUST_REMOTE_CODE=false

# Optional remote OpenAI-compatible fallback:
# LLM_BACKEND=openai_compatible
# LLM_PROVIDER_NAME=iFlow
# LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=https://apis.iflow.cn/v1
# LLM_MODEL=deepseek-r1
